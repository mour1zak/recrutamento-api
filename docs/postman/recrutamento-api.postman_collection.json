            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 empresa criada', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('endereço enriquecido pelo CEP real', () => pm.expect(body.city).to.eql('São Paulo'));",
