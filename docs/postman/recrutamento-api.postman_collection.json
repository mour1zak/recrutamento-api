        {
          "name": "POST /companies sem CEP -> 400",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('400 DTO inválido (CEP obrigatório)', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
