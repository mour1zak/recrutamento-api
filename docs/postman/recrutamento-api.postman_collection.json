                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
            ],
            "url": "{{baseUrl}}/users/{{candidateUserId}}/deactivate"
          }
        },
        {
          "name": "POST /auth/login do usuário desativado -> 401 (prova que desativou de verdade)",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('401 usuário desativado não loga', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{throwawayEmail}}\",\n  \"password\": \"{{throwawayPassword}}\"\n}" }
          }
        },
        {
          "name": "PATCH /users/:id/reactivate (admin) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 reativado', () => pm.response.to.have.status(200));",
                  "pm.test('isActive true no corpo', () => pm.expect(pm.response.json().isActive).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
            ],
            "url": "{{baseUrl}}/users/{{candidateUserId}}/reactivate"
          }
        },
        {
          "name": "POST /auth/login do usuário reativado -> 200 (prova que reativou de verdade)",
          "event": [
