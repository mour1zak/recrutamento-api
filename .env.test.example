NODE_ENV=test
PORT=3001

# Banco de dados de TESTE — dedicado, descartável, recriado a cada
# `npm run db:reset:test`. Recomendado: mesmo usuário `recrutamento_app`
# do .env de dev (dono das duas databases), banco diferente.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/recrutamento_test?schema=public"

# JWT — gere um valor PRÓPRIO, diferente do usado no .env de dev/produção
# (nunca reaproveite entre ambientes). Sugestão: openssl rand -hex 32
JWT_SECRET="troque-por-um-valor-aleatorio-de-32-bytes-em-hex"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API key de teste — diferente da usada em dev/produção. Sugestão: openssl rand -hex 24
API_KEY="troque-por-um-valor-aleatorio"

EXTERNAL_CEP_API_URL="https://viacep.com.br/ws"
EXTERNAL_CEP_TIMEOUT_MS=3000

UPLOAD_DIR="uploads-test"
MAX_UPLOAD_SIZE_MB=5
