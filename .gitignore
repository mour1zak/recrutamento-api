# Dependências
node_modules/

# Build
dist/
build/
*.tsbuildinfo

# Prisma Client gerado (recriado via `npx prisma generate`, não versionar)
src/generated/

# Variáveis de ambiente (nunca versionar segredos reais)
.env
.env.*
!.env.example
# Exceção deliberada (achado Qwen rodada 4, C3): .env.test só tem
# credenciais de um banco de teste local descartável (recrutamento_test),
# nunca dados reais — versionado para que `npm run test:e2e` funcione num
# clone novo sem configuração manual. Nunca reaproveitar estes valores em
# dev/produção.
!.env.test

# Uploads enviados por usuários em ambiente local (não é código-fonte)
uploads/
storage/

# Logs
*.log
logs/

# Observabilidade — dados persistidos localmente pelos containers, não config
docker/loki-data/
docker/grafana-data/

# Testes / cobertura
coverage/
test-results/

# Editor / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ferramenta de IA usada no desenvolvimento (config local de preview do
# Claude Code) — sem uso pra quem clona o projeto, não deve ser versionada.
.claude/

# Docker (dados de volumes, nunca a config em docker/*.yml)
*.pid
