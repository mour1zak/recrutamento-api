            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{throwawayEmail}}\",\n  \"password\": \"{{throwawayPassword}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "3. Companies",
      "item": [
        {
          "name": "POST /companies SEM permissão (recruiter) -> 403",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('403 sem company:create', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{recruiterAccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
