{
  "info": {
    "name": "Recrutamento API — Validação Manual (Auth + Users + Companies)",
    "description": "Roteiro completo pra rodar na ordem (de cima pra baixo, pasta por pasta). Cada requisição já vem com um teste que confere o status esperado e, quando aplicável, salva tokens/ids nas variáveis do ambiente automaticamente — não precisa copiar nada na mão. Use o ambiente 'recrutamento-api (local)' e preencha `apiKey` com o valor real do seu `.env` antes de começar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "throwawayEmail", "value": "" },
    { "key": "throwawayPassword", "value": "Descartavel@123" },
    { "key": "registeredEmail", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "GET /health sem API key -> 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 sem API key', () => pm.response.to.have.status(401));",
                  "pm.test('header WWW-Authenticate presente', () => pm.response.to.have.header('WWW-Authenticate'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /health com API key -> 200",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('200 com API key', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "POST /auth/register -> 201 (novo candidato)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('registeredEmail', `teste-postman-${Date.now()}@example.com`);"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 registrado', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('não devolve password', () => pm.expect(body.user.password).to.be.undefined);",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teste Postman\",\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"SenhaForte@123\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/register com o MESMO email -> 409",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('409 email duplicado', () => pm.response.to.have.status(409));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teste Postman Duplicado\",\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"SenhaForte@123\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/register sem email -> 400",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('400 DTO inválido', () => pm.response.to.have.status(400));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sem Email\",\n  \"password\": \"SenhaForte@123\"\n}" }
          }
        },
        {
          "name": "POST /auth/login sem API key -> 401",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('401 sem API key', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"qualquer@example.com\",\n  \"password\": \"qualquer\"\n}" }
          }
        },
        {
          "name": "POST /auth/login senha errada -> 401",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('401 credenciais inválidas', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@recrutamento.test\",\n  \"password\": \"senha-errada\"\n}" }
          }
        },
        {
          "name": "POST /auth/login ADMIN -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 login admin', () => pm.response.to.have.status(200));",
                  "pm.environment.set('adminAccessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@recrutamento.test\",\n  \"password\": \"{{seedPassword}}\"\n}" }
          }
        },
        {
          "name": "POST /auth/login RECRUITER -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 login recruiter', () => pm.response.to.have.status(200));",
                  "pm.environment.set('recruiterAccessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"recrutador@recrutamento.test\",\n  \"password\": \"{{seedPassword}}\"\n}" }
          }
        },
        {
          "name": "POST /auth/login CANDIDATE (seed) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 login candidate', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('candidateAccessToken', body.accessToken);",
                  "pm.environment.set('candidateUserId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"candidato@recrutamento.test\",\n  \"password\": \"{{seedPassword}}\"\n}" }
          }
        },
        {
          "name": "POST /auth/refresh -> 200 (rotaciona o token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 refresh', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "POST /auth/logout sem JWT -> 401",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('401 sem JWT', () => pm.response.to.have.status(401));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"qualquer\"\n}" }
          }
        },
        {
          "name": "POST /auth/logout com JWT -> 204",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('204 logout', () => pm.response.to.have.status(204));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "POST /auth/register usuário descartável (setup)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('throwawayEmail', `descartavel-postman-${Date.now()}@example.com`);"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 usuário descartável criado', () => pm.response.to.have.status(201));",
                  "pm.environment.set('candidateUserId', pm.response.json().user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Descartável\",\n  \"email\": \"{{throwawayEmail}}\",\n  \"password\": \"{{throwawayPassword}}\"\n}"
            }
          }
        },
        {
          "name": "PATCH /users/:id/deactivate SEM permissão (candidate) -> 403",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('403 sem permission key', () => pm.response.to.have.status(403));"] }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{candidateAccessToken}}" }
            ],
            "url": "{{baseUrl}}/users/{{candidateUserId}}/deactivate"
          }
        },
        {
          "name": "PATCH /users/999999/deactivate (admin, inexistente) -> 404",
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('404 usuário inexistente', () => pm.response.to.have.status(404));"] }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-api-key", "value": "{{apiKey}}" },
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
            ],
            "url": "{{baseUrl}}/users/999999/deactivate"
          }
        },
        {
          "name": "PATCH /users/:id/deactivate (admin, usuário descartável) -> 200",
          "event": [
            {
              "listen": "test",
