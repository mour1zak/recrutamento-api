NODE_ENV=development
PORT=3000

# Banco de dados — troque usuário/senha/host/porta/nome do banco pelos do seu ambiente.
# Recomendado: um usuário dedicado à aplicação, não o superusuário do Postgres.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/recrutamento_dev?schema=public"

# JWT — gere um valor aleatório forte por ambiente (nunca reaproveite entre dev/test/produção).
# Sugestão para gerar localmente: openssl rand -hex 32
# A aplicação recusa subir se este valor continuar igual ao deste arquivo
# (validação de ambiente no boot, src/config/env.validation.ts).
JWT_SECRET="troque-por-um-valor-aleatorio-de-32-bytes-em-hex"
JWT_EXPIRES_IN="15m"
# O refresh token é opaco (aleatório + hash), não um JWT assinado — não
# existe uma segunda chave de assinatura para ele.
JWT_REFRESH_EXPIRES_IN="7d"

# API key (camada adicional ao JWT, pedida pelo avaliador) — diferente por ambiente.
API_KEY="troque-por-um-valor-aleatorio"

# Integração externa — CEP/localização (usado por CepService, módulo Companies)
EXTERNAL_CEP_API_URL="https://viacep.com.br/ws"
EXTERNAL_CEP_TIMEOUT_MS=3000

# Upload de documentos
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=5

# Opcional — senha dos usuários criados por `prisma/seed.ts` (dev/test).
# Sem esta variável, o seed usa "Senha@123" como padrão. O seed recusa
# rodar se NODE_ENV=production.
SEED_USER_PASSWORD="Senha@123"
